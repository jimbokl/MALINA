{
  "name": "malina-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node site/scripts/build-atomic.mjs",
    "dev": "npm run build && python3 -m http.server 5181 --directory dist",
    "test": "node --test --test-concurrency=1 site/tests/*.test.mjs",
    "check:public": "node site/scripts/check-public.mjs",
    "seo:coverage": "node site/scripts/compile-seo-coverage.mjs",
    "seo:verify": "node site/scripts/verify-seo-coverage.mjs"
  }
}
